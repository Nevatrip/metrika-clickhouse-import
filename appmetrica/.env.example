# ClickHouse
CLICKHOUSE_HOST="localhost"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD="secret"
CLICKHOUSE_DATABASE="appmetrica"

# AppMetrica
APPMETRICA_TOKEN=            # OAuth-токен с правом appmetrica:read (make token / make token-check)
APPMETRICA_APP_ID=6378271    # ID приложения Nevatrip
APPMETRICA_SOURCES="events installations sessions_starts" # Таблицы Logs API через пробел (см. helpers/sources.py)

# Даты
FIRST_DATE=2026-10-26        # С какой даты грузить (дата создания приложения)
DAY_COUNT=30                 # Максимум дней за один запуск
RELOAD_DAYS=7                # Сколько последних дней перезаливать каждый раз (данные приходят с опозданием)

# Ожидание выгрузки (API отвечает 202, пока готовит файл)
POLL_SECONDS=30
POLL_TIMEOUT=3600
