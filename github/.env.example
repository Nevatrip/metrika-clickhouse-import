# ClickHouse
CLICKHOUSE_HOST="localhost"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD="secret"
CLICKHOUSE_DATABASE="github"

# GitHub
# Fine-grained token: Repository access → нужные репозитории, Permissions → Contents: Read-only (+ Metadata: Read-only)
GITHUB_TOKEN=
GITHUB_OWNER="Nevatrip"
# Обязательно. Репозитории через запятую
GITHUB_REPOS="nevatrip-web,buy-form,platform,cruises,tgbot,izzyduck"
GITHUB_BRANCH="main"

# Коммиты раньше этой даты не загружаются (YYYY-MM-DD). Пусто = вся история
GITHUB_COMMITS_FROM=2025-01-01
# Максимум запросов деталей коммита (список файлов) за один запуск. Лимит GitHub — 5000/час
GITHUB_MAX_DETAIL_CALLS=3000
